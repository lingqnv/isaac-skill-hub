# Isaac Skill Hub — Credentials
#
# Copy this to .env in your project root and fill in the values.
# .env is gitignored — never commit credentials.

# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens → Generate new token
# Scopes needed: repo (for private repos and PRs)
GITHUB_TOKEN=

# Agent Hub (auto-populated on first /helpImprove — leave blank)
# The agent auto-registers and saves the key here.
# If you already have an agent-hub.nvidia.com account, paste your key.
# NVAGENT_HUB_API_KEY=
# NVAGENT_HUB_EMAIL=
# NVAGENT_HUB_AGENT_NAME=
